{
  "name": "dsh-daily-zone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 侧边栏「日常区」：豆包网页版入口 + 免选工作区的直连对话 + 缓存自动清理 · A Daily Zone section for the DSH sidebar: an embedded Doubao web entry, workspace-free direct chat, and cache auto-cleanup.",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "sidebar",
    "plugin",
    "doubao",
    "cache-cleanup"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "test": "node tests/smoke-client.mjs",
    "check:encoding": "node tests/check-encoding.mjs ."
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "author": "userwq666",
  "homepage": "https://github.com/userwq666/dsh-daily-zone",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/userwq666/dsh-daily-zone.git"
  },
  "bugs": {
    "url": "https://github.com/userwq666/dsh-daily-zone/issues"
  }
}
